{
  "name": "city-api-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Starter for City of Asheville HTTP APIs: spec-first OpenAPI, Express on AWS Lambda.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint:spec": "spectral lint openapi.yaml --fail-severity=warn",
    "gen:types": "openapi-typescript openapi.yaml -o src/generated/openapi.ts",
    "gen:types:check": "openapi-typescript openapi.yaml -o src/generated/openapi.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint:spec && npm run gen:types:check && npm run typecheck && npm test",
    "breaking": "sh scripts/breaking.sh",
    "docs": "npx --yes @redocly/cli@2.76.0 build-docs openapi.yaml -o .docs/index.html",
    "package": "sh scripts/package.sh"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.17.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
